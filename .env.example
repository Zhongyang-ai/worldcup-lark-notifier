# Required: create a custom bot in the target Lark group.
LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/REPLACE_ME
# Optional: set this only when bot signature verification is enabled.
LARK_SECRET=

TIMEZONE=Asia/Singapore
POLL_LIVE_SECONDS=8
POLL_IDLE_SECONDS=60
REQUEST_TIMEOUT_SECONDS=12
NOTIFY_KICKOFF=true
NOTIFY_HALFTIME=true
NOTIFY_RED_CARD=true
SEND_EXISTING_ON_START=false
HEARTBEAT_HOUR=9
SCHEDULE_PREVIEW_HOUR=22
PREDICTION_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
LOG_LEVEL=INFO
DATABASE_PATH=data/worldcup.db
HEALTH_PORT=8080
